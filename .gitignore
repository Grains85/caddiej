# Local configuration and credentials
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
build/
dist/

# Local shot history. Somebody's rounds, not the project's.
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm

# Everything CaddieJ writes: swing footage of a person in their own garage, and
# the rendered audio of coaching lines about their swing. Both stay on their
# machine, and neither is something a commit can carry away by accident.
media/

# Isolated diagnostic output — extracted stills of a person in their garage.
.caddiej/

# Pose landmarker weights. Provision with scripts/install-pose-model.py.
# The checksum is checked there. The file is not part of the repository.
models/*.task
research/direct_visual_coach/models/*.task

# Fresh-swing validation: preserved shot directories and the sheets built from them.
research/temporal_evidence/fresh/baseline/
research/temporal_evidence/fresh/shots/
research/temporal_evidence/fresh/runs/*/*.jpg

# Session logs. Redirected stdout lands in the working directory, and a session
# log names holes, clubs and shot dispersion. Same reasoning as the database.
*.log

# Local scratch. Nothing here is the project's.
scratch/
tmp
tmp*.txt
*.m4v

# Virtual environments
.venv/
venv/

# Editors and operating systems
.DS_Store
.idea/
.vscode/
