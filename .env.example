# OBS WebSocket v5 connection settings
OBS_HOST=localhost
OBS_PORT=4455
OBS_PASSWORD=
OBS_CONNECT_TIMEOUT=10.0
OBS_TEST_SCENE=CaddieJ Test
OBS_TEST_STATUS_SOURCE=CaddieJ Status

# Floor overlay HUD server. Loopback only: the projector browser and OBS are
# local, and nothing here is safe to expose on a network.
HUD_HOST=127.0.0.1
HUD_PORT=8730
HUD_STARTUP_TIMEOUT=10.0
# How long any one step of shutdown gets.
SHUTDOWN_TIMEOUT=5.0
# How long all of them get together. Each step already has its own budget above,
# and the sum of them is longer than the grace an operating system allows between
# "please stop" and SIGKILL — so this caps the total, and what is left when it
# runs out is stepped over. Pressing Ctrl+C a second time leaves immediately.
SHUTDOWN_GRACE=20.0
FLOOR_STATUS_TEXT=CADDIEJ FLOOR ONLINE

# Development only: cycle the floor through every state it can render — marker
# variants, placements, club paths, metrics — so the projection can be reviewed
# without a launch monitor. Leave off for normal use.
FLOOR_DEMO=false
FLOOR_DEMO_STEP_SECONDS=2.5

# Physical hitting bay, in metres. Club-path angles are computed on this
# rectangle and then mapped onto the unit square the overlay draws. The
# default 1 × 1 is the identity, so a fresh checkout looks as it always has.
# Set these to the real bay (4 × 3 is a typical projected rectangle) when a
# 10° path should be 10° on the floor. Neither value is a pixel count.
FLOOR_WIDTH_M=1.0
FLOOR_DEPTH_M=1.0
# THE HITTING STRIP IS THE ANCHOR.
#
# It is the one thing in the room that is physically real and physically
# moveable: somebody lays a mat down, aims a projector at it, and measures it.
# Everything golf-related on the floor is placed FROM it, so moving the mat —
# or moving the projector and re-measuring — is these two numbers and nothing
# else. X and Y are the physical CENTRE of the rectangle, in metres on the bay
# above; not a corner, and not a fraction. Width/depth are a generic turf pad,
# so calibrate them against the real one.
FLOOR_HITTING_STRIP_X_M=0.5
FLOOR_HITTING_STRIP_Y_M=0.72
FLOOR_HITTING_STRIP_WIDTH_M=0.30
FLOOR_HITTING_STRIP_DEPTH_M=0.45
# Fill the whole calibrated rectangle instead of outlining it, so the projector
# lights the physical turf in a dark bay. The ball marker inverts to stay
# readable on top of it. Off by default.
FLOOR_HITTING_STRIP_FILL=false
# Uniform scale of the Compact ball-status chamfer on the rear edge. 1 is the
# drawing. Every size — rise, run, span, stroke, type, lamp, and the gaps —
# is multiplied by this, and the feet stay on the rear edge. It does not move
# the strip and it does not change the bay. 6 is what a projector needs before
# the words can be read standing over the ball.
BALL_STATUS_CHAMFER_SCALE=6.0

# Everything below is an OFFSET from the strip centre above, in metres.
# +X is across the bay towards the player's right and +Y is towards the
# player, so DOWN-RANGE IS NEGATIVE. Zero is the middle of the mat. These say
# how content sits on the strip, which does not change when the strip moves.
#
# Three ball positions, because a driver and a putter are not played from
# where a 7 iron is. Every other club, and a club nothing has named yet, uses
# the iron position.
FLOOR_BALL_IRON_DX_M=0.0
FLOOR_BALL_IRON_DY_M=0.0
FLOOR_BALL_DRIVER_DX_M=0.0
FLOOR_BALL_DRIVER_DY_M=0.0
# The putter is allowed off the mat, and by default is: 0.30 m down-range of
# the centre is past the front edge of a 0.45 m strip. That is the point of it
# being a third position rather than a variation on the first.
FLOOR_BALL_PUTTER_DX_M=0.0
FLOOR_BALL_PUTTER_DY_M=-0.30
# Where the numbers a player reads while standing at the strip are drawn:
# distance to the pin, the recommended club, what the last shot did, what is
# left, and the coaching line under them. −0.66 m puts them where they have
# always been on the default 1 m × 1 m bay. The startup banner, celebrations
# and the link light are deliberately NOT anchored — they are drawn across the
# whole projection and have nothing to do with a mat.
FLOOR_INFORMATION_DX_M=0.0
FLOOR_INFORMATION_DY_M=-0.66
# Putting mode: while a putter is in play the floor draws the putter ball
# position and a plain lane running down-range from it, and nothing else. The
# lane is how a player can see the floor noticed the club changed.
FLOOR_PUTTING_LANE=true
FLOOR_PUTTING_LANE_LENGTH_M=0.30
FLOOR_PUTTING_LANE_WIDTH_M=0.24
# How far the club-path line is drawn, in metres of the physical floor.
# About a pace: long enough to read at the player's feet on a real bay,
# short enough not to run the length of the hitting strip. The old
# default 0.35 was a leftover from treating this as a 0–1 fraction on a
# 1 m × 1 m test floor.
FLOOR_CLUB_PATH_LENGTH=1.2
# How long a shot's path and numbers stay on the floor before it goes back to
# showing where the next ball goes. Keep it shorter than the gap between shots.
FLOOR_SHOT_DISPLAY_SECONDS=6.0
# Observer round-result panel. It cannot appear until GSPro has finished flying
# the ball, which on real hardware is 3-6 s after the strike, so both ends of
# its lifetime are set here.
#
# MIN: guaranteed readable for this long even if the next ball is teed up
# straight away. A dismissal that arrives inside it is applied the moment it
# ends, so nobody waits out the cap. The address marker is never held back.
# MAX: the longest the panel may stay if no new address cycle arrives at all.
# A new shot outranks both.
FLOOR_SHOT_RESULT_MIN_DURATION=8
FLOOR_SHOT_RESULT_MAX_DURATION=30

# Your bag, in metres of carry. CaddieJ shows the club whose carry is nearest
# the distance GSPro says is left to the target, while the next shot is being
# addressed. Metres because that is what GSPro's DistanceToTarget is; nothing
# converts anything.
#
# Zero means "not in the bag", and every club at zero — which is what ships —
# means no club is ever recommended. That is deliberate: CaddieJ has not
# measured you, and a set of plausible numbers would be a guess presented as a
# measurement. The floor shows the distance on its own until you fill these in.
#
# Carry, not total. Roll depends on the hole; the number that belongs to the
# club is how far it flies. Measure it on the range rather than from a best
# shot: this chooses a club for the shot you usually hit.
#
# Expect these to be replaced by carries learned from your own shot history.
# When that happens only where the numbers come from changes, so nothing you
# set here is load-bearing beyond this file.
PLAYER_CLUB_CARRY_DRIVER_M=0
PLAYER_CLUB_CARRY_3W_M=0
PLAYER_CLUB_CARRY_5W_M=0
PLAYER_CLUB_CARRY_4I_M=0
PLAYER_CLUB_CARRY_5I_M=0
PLAYER_CLUB_CARRY_6I_M=0
PLAYER_CLUB_CARRY_7I_M=0
PLAYER_CLUB_CARRY_8I_M=0
PLAYER_CLUB_CARRY_9I_M=0
PLAYER_CLUB_CARRY_PW_M=0
PLAYER_CLUB_CARRY_GW_M=0
PLAYER_CLUB_CARRY_SW_M=0

# GSPro and ProTee. Production observation is passive: ProTee talks to GSPro
# directly, and CaddieJ reads the ProTee log plus GSPro's currentRound.dat.
# Stopping CaddieJ then has no effect on either. Interpose remains for
# diagnostics: CaddieJ accepts the launch monitor and forwards to GSPro.
#
#   off        nothing is ingested
#   observe    production: read ProTee's log and GSPro's currentRound.dat.
#              Does not listen on 9210.
#   interpose  experimental/debug: a launch monitor connects to CaddieJ
#   simulate   a scripted round played by a fake device against a fake GSPro,
#              through the real adapter, so the floor can be watched without a
#              simulator, a launch monitor, or a golf swing. Development only.
GSPRO_MODE=off
GSPRO_BIND_HOST=127.0.0.1
GSPRO_BIND_PORT=9210
# Where GSPro itself listens. 921 is the documented Open Connect port.
GSPRO_UPSTREAM_HOST=127.0.0.1
GSPRO_UPSTREAM_PORT=921
GSPRO_CONNECT_TIMEOUT=5.0
# How long a bridged connection may say nothing before CaddieJ stops believing it
# is there. A launch monitor that vanished without closing its socket — a laptop
# lid, a dropped wireless link — otherwise holds the single bridge slot and
# refuses every later connection until CaddieJ is restarted. Far longer than any
# heartbeat interval, because being wrong costs a reconnect. 0 switches it off.
GSPRO_IDLE_TIMEOUT=180.0
# How long CaddieJ refuses the launch monitor after failing to reach GSPro. Also
# how long someone who starts GSPro last waits before shots flow, so keep it
# short.
GSPRO_BACKOFF_INITIAL=0.5
GSPRO_BACKOFF_MAX=5.0
GSPRO_MAX_MESSAGE_BYTES=65536
# How long a shot missing half its data waits for the rest. Never delays
# forwarding, only CaddieJ's own reaction.
GSPRO_SHOT_ASSEMBLY_WINDOW=0.25
# Ball detection arrives as a flag on every heartbeat, and is debounced
# asymmetrically: a ball appearing is believed at once so the floor stops
# projecting onto the ball, while a ball disappearing is given time so a single missed
# heartbeat does not flash the marker back on under the player's club.
GSPRO_BALL_PRESENT_DEBOUNCE=0.0
GSPRO_BALL_ABSENT_DEBOUNCE=1.5
# How long the simulated round pauses between steps. Slow enough to watch.
GSPRO_SIMULATION_STEP_SECONDS=3.0
# Passive observation (GSPRO_MODE=observe). Empty paths derive the Windows
# defaults from %USERPROFILE% and %APPDATA%. They are never written to.
GSPRO_ROUND_OBSERVER_ENABLED=true
GSPRO_ROUND_FILE_PATH=
GSPRO_ROUND_POLL_INTERVAL=0.1
PROTEE_OBSERVER_ENABLED=true
PROTEE_ROOT_PATH=
PROTEE_LOG_POLL_INTERVAL=0.1

# Local shot history, in one SQLite file you own: copy it, open it with the
# sqlite3 shell, delete it. On by default, because a session that was not
# recorded cannot be recovered afterwards.
HISTORY_ENABLED=true
HISTORY_DATABASE_PATH=caddiej.sqlite3
# No launch monitor and no simulator reports who is playing — Open Connect
# carries handedness and nothing else about a player — so a name here is how
# shots get one. Leave blank to store them unnamed.
PLAYER_NAME=
SESSION_LABEL=
# How many shots may be waiting to be written before further ones are refused.
# Reaching this needs a wedged disk: storing a shot takes microseconds and
# hitting the next one takes a person at least ten seconds.
HISTORY_QUEUE_SIZE=256
# How long SQLite waits for a file another process has locked, and how long
# shutdown waits for queued shots to reach the disk.
HISTORY_BUSY_TIMEOUT=5.0
HISTORY_DRAIN_TIMEOUT=5.0
# Keep the exact bytes the device sent for each shot, for diagnosing a device
# that reports something unexpected. Off by default: it grows the file with data
# nothing reads, and the payloads can be deleted at any time without loss.
HISTORY_RECORD_RAW_PAYLOADS=false
HISTORY_RAW_PAYLOAD_MAX_BYTES=8192

# Swing video. Off by default, unlike history: it writes gigabytes to the disk
# and it films whoever is standing on the mat, and both of those should be a
# decision somebody made rather than one they inherited. Needs FFmpeg on PATH.
VIDEO_ENABLED=false
# "synthetic" needs no camera at all — FFmpeg generates a test pattern — so the
# whole path from a shot to a clip can be watched working before any hardware is
# involved. Then: avfoundation on macOS, v4l2 on Linux, dshow on Windows.
VIDEO_CAMERA_KIND=synthetic
# An AVFoundation index on macOS ("0"), a device node on Linux
# ("/dev/video0"), a DirectShow friendly name on Windows ("HD Pro Webcam C920").
# List them with:
#   macOS:   ffmpeg -f avfoundation -list_devices true -i ""
#   Linux:   v4l2-ctl --list-devices
#   Windows: ffmpeg -f dshow -list_devices true -i dummy
VIDEO_CAMERA_DEVICE=0
# Names the camera in filenames, events and health. Worth setting once a second
# camera is likely: "face-on" and "down-the-line" age better than "tee".
VIDEO_CAMERA_ID=tee
# Where the camera stands: unknown, face_on, or down_the_line. Nothing can work
# this out from the footage, and it decides what a still can honestly be read
# for — face-on shows posture and sway, down-the-line shows plane and shaft.
# Left unknown, a recorded clip does not claim an angle. The swing assessment
# uses the capture panels, not this camera.
VIDEO_CAMERA_VIEW=unknown
VIDEO_CAMERA_FPS=30
VIDEO_CAMERA_WIDTH=1280
VIDEO_CAMERA_HEIGHT=720
# How long after the light reaches the sensor a frame gets its timestamp.
# Device-specific, usually tens of milliseconds. Zero means nobody has measured
# it, which is why clips are cut wide and marked "estimated" rather than trusted
# to the frame.
VIDEO_CAMERA_LATENCY_SECONDS=0.0
# Everything video writes lives under here. Deleting this directory is always
# enough, and always safe.
VIDEO_MEDIA_ROOT=media
VIDEO_FFMPEG_PATH=ffmpeg
# libx264 works everywhere. On a machine with a hardware encoder, using it keeps
# the CPU for the golf: h264_videotoolbox on macOS, h264_nvenc on NVIDIA,
# h264_qsv on Intel.
VIDEO_ENCODER=libx264
VIDEO_BITRATE=8M
# How much of the swing to keep either side of impact. The pre-impact window is
# generous because it absorbs the backswing plus two unknowns: how late the
# launch monitor reported the shot, and how late the camera timestamped the
# frame.
VIDEO_PRE_IMPACT_SECONDS=2.0
VIDEO_POST_IMPACT_SECONDS=1.5
# How much footage is kept ready to be clipped, bounded by both time and size.
# Well beyond one clip, because a clip is cut after the shot and a busy disk must
# not be able to recycle the swing before the worker reaches it.
VIDEO_BUFFER_SECONDS=30.0
VIDEO_BUFFER_MAX_BYTES=2147483648
# A clip is a whole number of segments, so this is also how precisely a
# requested window can be honoured.
VIDEO_SEGMENT_SECONDS=1.0
VIDEO_KEYFRAME_SECONDS=0.5
# How long before the shot message the ball was actually struck. A launch
# monitor that takes a second to report needs this, or every clip is centred a
# second late, on the golfer walking away.
VIDEO_SHOT_REPORT_LAG_SECONDS=0.0
# Clip requests that may be waiting before further ones are refused, and how
# long a single extraction may take before it is abandoned.
VIDEO_CLIP_QUEUE_SIZE=8
VIDEO_EXTRACT_TIMEOUT=30.0
# How long finished clips are kept. Whole days, matching the directories they
# are filed in; anything older is deleted at start-up. Set to 0 to keep every
# clip, if they are being archived somewhere else.
VIDEO_CLIP_RETENTION_DAYS=30
# Consecutive failures to start filming before the camera is left alone. It is
# reported, and CaddieJ carries on without it.
VIDEO_RESTART_LIMIT=5
VIDEO_DRAIN_TIMEOUT=5.0

# Coaching is Ideal Swing 2.9. A shot is assessed only when vision calls are
# on and a provider is configured. The approved correction comes from
# config/ideal_swing.json. The model does not rewrite it.
COACHING_ENABLED=true
# "none" asks no model and costs nothing. "scripted" answers from inside the
# process, with no credentials. "openai" is the vision assessment.
COACHING_PROVIDER=none
COACHING_MODEL=gpt-5-mini
# Never committed. Put it in .env, which is gitignored, or export it in the
# shell. It is held as a secret so it cannot surface in a traceback, and the log
# formatter has no field that could carry it.
COACHING_API_KEY=
# Any OpenAI-compatible endpoint, including a local one. Blank uses OpenAI's.
# COACHING_API_BASE=http://localhost:11434/v1
COACHING_API_BASE=
# Width of stills pulled from a recorded camera clip by --check-video-frames.
# The evidence pipeline does not use this width.
COACHING_FRAME_WIDTH=512
# A coached result stays on the floor until the next ball is struck.
# How many vision calls one run may make. Past this, the round continues
# without another assessment.
COACHING_CALL_LIMIT=60
# Three counts, and they are not interchangeable.
# COACHING_EVIDENCE_BUDGET is how many timeline frames the coach may send.
# SWING_CAPTURE_SELECTED_FRAMES (below) is how many published replay stills
# capture keeps. SWING_CAPTURE_DIAGNOSTIC_TIMELINE_SHOTS (below) is how many
# shots keep a full timeline for timing checks. Default budget 24: 20
# down-the-line and 4 face-on.
COACHING_EVIDENCE_BUDGET=24
# dtl_primary is 20 down-the-line and 4 face-on at a budget of 24.
# Also: dtl_only, balanced, fo_primary. A different budget scales the weights.
COACHING_EVIDENCE_ALLOCATION=dtl_primary
# Paid vision assessment of a live shot. Off until set. While off, a captured
# shot is not assessed and nothing is spoken in its place.
# The saved-swing command is the same pipeline:
#   caddiej --analyze-reference-swing --reference-package <evidence_package.json> \
#     --reference-shot-dir <raw capture> --reference-mock insufficient
# A real vision call also needs COACHING_VISION_CALLS=true, or
# --reference-call-model on the saved-swing command.
COACHING_VISION_CALLS=false
# How closely each swing still is read. high costs more tokens than low and is
# the default because hands, shaft and hips are small in the frame. auto leaves
# the provider's choice. This does not change how many images are sent.
COACHING_IMAGE_DETAIL=high
# How the approved sentence is said. exact speaks only that sentence.
# observed may place the assessment's own observation in front of it.
# worded asks a second call for that observation. The correction is never
# rewritten. observed is the default: one vision call, no wording call.
COACHING_FEEDBACK=observed
# Seconds for one vision attempt, and the budget that bounds it.
COACH_OPENAI_TIMEOUT_SECONDS=30
COACH_OPENAI_BUDGET_SECONDS=45
# Draw the cue graphic on the floor. Off until real artwork exists: a
# placeholder must not appear as instructional content on the hitting mat.
FLOOR_COACH_CUE_IMAGE=false

# Local text to speech. Off by default, and deliberately: it makes noise in your
# house, and the first run downloads a few hundred megabytes of speech model.
# Needs `pip install -e '.[tts]'`, and on Linux also PortAudio
# (apt install libportaudio2). Synthesis is entirely local; nothing is sent
# anywhere and no account is involved.
#
# Speech follows the coached line. With the default provider of "none" and
# vision calls off, the room stays quiet. A vision assessment needs
# COACHING_VISION_CALLS=true and a configured provider.
SPEECH_ENABLED=false
# kokoro is the local model. "fake" renders silence of a believable length, which
# exercises the queue, the events and the floor with nothing installed.
SPEECH_ENGINE=kokoro
# "none" renders every line and plays nothing, for a headless machine or for
# anyone who wants the speech events without the sound.
SPEECH_OUTPUT=sounddevice
# The first letter of the voice picks the language: b is British, a is American.
# British: bm_george, bm_lewis, bm_daniel, bm_fable, bf_emma, bf_alice,
# bf_isabella, bf_lily.
SPEECH_VOICE=bm_george
SPEECH_SPEED=1.0
# A PortAudio device index or name. Blank uses the system default, which is what
# almost everybody wants and the only setting that survives replugging speakers.
SPEECH_DEVICE=
# One constant multiplier on every line, applied at the speaker and never to the
# cached file, so changing it retires nothing. Kokoro peaks around a third of
# full scale, so there is real headroom here and a bay with the Windows mixer
# already at maximum can still be too quiet. 1.0 is the engine's own level.
# Measure before raising it: `caddiej --check-speech` reports what share of the
# samples the gain clipped, and anything above a fraction of a percent is
# distortion rather than volume.
SPEECH_GAIN=1.0
# Short, like the coaching queue: a newer coaching line replaces an older waiting
# one, so this only ever holds genuinely different things to say.
SPEECH_QUEUE_SIZE=4
# A ceiling on one sentence, so a bad line cannot occupy the room for a minute.
SPEECH_MAX_CHARACTERS=300
# Generous, because it also covers a cold model on a busy machine.
SPEECH_RENDER_TIMEOUT=20.0
# Loading the voice, which on a first run includes downloading it. Everything
# after speech in start-up waits behind this, so it is bounded: a quiet room is a
# supported way to run CaddieJ, and a start-up that never finishes is not.
SPEECH_OPEN_TIMEOUT=90.0
# Rendered lines kept as WAV files, because coaching repeats itself by design.
# Under the media root, so deleting that directory still removes everything
# CaddieJ has written. The files are playable if you want to hear what it said.
SPEECH_CACHE_ENABLED=true
SPEECH_CACHE_ROOT=media/speech
SPEECH_CACHE_BYTES=33554432
SPEECH_CACHE_FILES=512

# --- Lighting -----------------------------------------------------------------
# The room reacts, very slightly, while CaddieJ talks. The brightness comes from
# a measurement of the audio that is about to be played, so the lights follow the
# actual words rather than a timer or a guess.
#
# Off by default, and for a different reason from everything else here: this is
# the only feature that reaches out and changes something in somebody's house
# that they set the way they wanted it. It gives the room back afterwards, and
# letting it touch the lights at all should still be a decision somebody made.
#
# Needs the optional dependency:  pip install -e ".[hue]"
LIGHTING_ENABLED=false

# "none" runs the whole path — measurement, tick, rate limit, restore — and
# changes no lamp. For a machine with no bridge, and for seeing in the log what
# the lights would have done.
LIGHTING_OUTPUT=hue

# The bridge's address on the local network. An IP is steadier than a hostname:
# bridges answer to mDNS names that come and go.
LIGHTING_BRIDGE_HOST=

# From the one-time pairing step. Press the button on the bridge, then within
# thirty seconds:
#
#   curl -k -X POST https://<bridge>/api \
#        -d '{"devicetype":"caddiej#floor","generateclientkey":true}'
#
# and copy the "username" out of the answer. It is a credential: keep it here,
# out of the repository, exactly like an API key. Nothing logs it.
LIGHTING_APPLICATION_KEY=

# Which lamps to use, by name or by identifier, comma separated. Blank means
# every light the bridge knows about, which is convenient and probably not what
# somebody with a whole house of them wants. Names are what a bridge shows in the
# Hue app; matching ignores case.
LIGHTING_LIGHTS=

# How far the lights move while CaddieJ talks, as a fraction of whatever they
# were already at when it started. Fractions rather than absolute brightness, so
# the same setting is subtle in a room at twenty per cent and in one at full.
#
# The default dips by not quite a fifth in the gaps between words and returns to
# normal on them. That direction is deliberate: dipping has room to work at any
# brightness, while lifting has none at all when the lights are already full.
# Setting both to the same value switches the reaction off.
LIGHTING_MINIMUM=0.82
LIGHTING_MAXIMUM=1.0

# The bridge's whole command budget, shared across every lamp in use. Ten a
# second is Philips' own guidance, so this is a limit to respect rather than a
# preference: how often the lights are written is derived from it and the number
# of lamps, and raising it makes a bridge start refusing commands rather than
# reacting faster.
LIGHTING_MAX_COMMANDS_PER_SECOND=10.0

# How long each command is given to complete, as a multiple of the gap to the
# next one. At one, the bridge is always interpolating towards the next value and
# the result looks continuous; below one it arrives early and waits, which looks
# like a staircase.
LIGHTING_TRANSITION_SCALE=1.0

# Consecutive failures before the bridge is left alone for a while. A bridge that
# has been unplugged fails everything, and retrying it once per syllable for an
# evening is worse than waiting a minute and trying again.
LIGHTING_FAILURE_LIMIT=3
LIGHTING_COOLDOWN_SECONDS=60.0

# Short. This is a small appliance on the same network, and a command that has
# not landed within a few seconds is a command whose moment has passed.
LIGHTING_COMMAND_TIMEOUT=3.0

# ---------------------------------------------------------------------------
# Effects: what the room does about a good hole
# ---------------------------------------------------------------------------
#
# Nothing publishes a scoring event yet — recognising a birdie needs a hole, a
# par and a stroke count, and GSPro's Open Connect feed carries shots, not a
# scorecard. So all of this is inert until scoring exists, and is on by default
# because the moment it does exist nothing here needs changing.
#
# Orchestration is deterministic and local. Five outcomes map to five fixed
# reactions in one table in `caddiej/effects/catalogue.py`. No model decides
# whether something happened or how loud the response should be: it would
# occasionally be wrong about a number somebody can see, and it would never be
# the same twice, which is the difference between a landmark and a novelty.
EFFECTS_ENABLED=true

# One switch per output, so a celebration can be seen and not heard, or heard and
# not seen. Each is independent of whether the subsystem behind it is running:
# switching the lights channel on with no bridge configured changes nothing.
EFFECTS_FLOOR=true
EFFECTS_SPEECH=true
EFFECTS_LIGHTS=true

# OBS is off by default, and has to be: this reveals a source in a scene that
# somebody built, and CaddieJ creates neither. Whatever is inside the source — a
# stinger, a graphic, an animation, a sound — is entirely yours; CaddieJ turns it
# on for the length of the effect and turns it off again.
#
# To use it: add a source to a scene, hide it, and name both here.
EFFECTS_OBS=false
EFFECTS_OBS_SCENE=
EFFECTS_OBS_SOURCE=

# An optional text source, captioned with the outcome — PAR, BIRDIE, EAGLE,
# ALBATROSS, HOLE IN ONE — so a scene can say it without a graphic per outcome.
# Blanked when the effect ends, because a text source left reading HOLE IN ONE
# shows up in a recording days later.
EFFECTS_OBS_TEXT_SOURCE=

# The hard cap on how long any effect may hold the room, whatever the catalogue
# says. A backstop against a typo in a duration rather than a tuning knob: the
# longest thing in the catalogue is five seconds.
EFFECTS_MAX_SECONDS=8.0

# How long any single output gets to accept a command. Short, because this is the
# timeout that stops an OBS which connects and then stops answering from holding
# a celebration open.
EFFECTS_CHANNEL_TIMEOUT=3.0

# ---------------------------------------------------------------------------
# Assistant API: letting a voice assistant ask CaddieJ questions
# ---------------------------------------------------------------------------
#
# A small authenticated HTTP surface on loopback, and an MCP translator in a
# separate process that speaks it. Six tools: five that read, one that changes
# what coaching leans towards. See ASSISTANT_API.md.
#
# Nothing in the simulator depends on this. It is read from the enrichment tier
# only, it is started after the room is already working, and if it fails to
# start CaddieJ logs it and carries on serving the floor.
#
# Off by default, and this default is not caution for its own sake: switching it
# on opens a port that answers questions about what somebody did in their own
# house. That should be a decision an operator made rather than one they
# inherited.
ASSISTANT_API_ENABLED=false

# Loopback, and enforced rather than defaulted: a non-loopback value here is
# refused at start-up and the API does not come up. Unlike the HUD, this has a
# bearer token and a mutation route, so a wildcard bind is a mistake worth
# refusing outright. To reach it from another machine, tunnel to it over SSH.
ASSISTANT_API_HOST=127.0.0.1
ASSISTANT_API_PORT=8731

# Required. There is no default and no token generated at start-up: an invented
# token would have to be printed or written somewhere for the assistant to find
# it, and every mechanism for doing that is worse than asking for one. With this
# blank and the API enabled, CaddieJ refuses to open the port and says so.
#
# Set the same value in the assistant's environment as CADDIEJ_API_TOKEN. It is
# never logged: the formatter's allowlist has no field that could carry it.
ASSISTANT_API_TOKEN=

# Whether an assistant may change anything at all. Separate from the switch
# above, so "let it read" and "let it write" are two decisions. Off means the
# mutating route is not registered and the MCP server does not offer the tool —
# an assistant discovers a read-only CaddieJ by not being given a way to write.
ASSISTANT_API_ALLOW_MUTATIONS=false

# Whether coaching prose crosses the boundary, off by default for the same
# reason camera frames are. The named fault and its severity are facts about a
# golf swing; the sentences are a record of somebody being told what they are
# doing wrong in their own home. With this off, an assistant still sees that the
# player has been fighting an open face and how badly — enough to be useful,
# without handing over a transcript of the session.
ASSISTANT_API_INCLUDE_COACHING_PROSE=false

ASSISTANT_API_STARTUP_TIMEOUT=10.0

# OBS Browser Source that renders the floor overlay. Provisioning is off by
# default because it modifies the active scene collection; the scene itself must
# already exist.
OBS_FLOOR_SCENE=CaddieJ Test
OBS_FLOOR_SOURCE=CaddieJ Floor
OBS_FLOOR_WIDTH=1920
OBS_FLOOR_HEIGHT=1080
OBS_PROVISION_FLOOR_SOURCE=false

# Temporarily reveal an existing OBS Window Capture of ProTee's Shot Video
# panel (club/path overlays included). CaddieJ does not create, crop, transform,
# or reorder that source. Stack it above CaddieJ Floor in OBS_FLOOR_SCENE.
# Off by default so a missing source cannot surprise a first run.
FLOOR_SHOT_VIDEO_ENABLED=false
OBS_SHOT_VIDEO_SOURCE=Shot Video
# Delay is a first guess so ProTee can refresh the panel; tune on hardware.
FLOOR_SHOT_VIDEO_DELAY_SECONDS=0.75
FLOOR_SHOT_VIDEO_DURATION_SECONDS=4

# The same again for ProTee's Top Impact view. Separate settings rather than a
# list, because a bay commonly has one of the two captured and not the other,
# and because each wants its own timing. The two are independent all the way
# down: their own OBS connection, their own timers, their own failures. Neither
# can cost the other a reveal, and neither can delay the floor.
#
# The default delay is longer than Shot Video's because the impact image is
# drawn after the swing; correct it from a real shot. Prove the OBS half with
# `caddiej --check-obs-top-impact` before blaming the timing.
#
# The floor item is separate from swing capture's: the source needs a hidden
# item in OBS_FLOOR_SCENE (Add Existing, above CaddieJ Floor, eye off) even
# when SWING_CAPTURE_SCENE already holds an enabled one. `Impact` here is fine
# when it is the same source capture reads. OBS_FLOOR_SCENE must never be
# SWING_CAPTURE_SCENE; /healthz shows `top_impact.state` while it is missing.
FLOOR_TOP_IMPACT_ENABLED=false
OBS_TOP_IMPACT_SOURCE=Top Impact
FLOOR_TOP_IMPACT_DELAY_SECONDS=1.5
FLOOR_TOP_IMPACT_DURATION_SECONDS=4

# --- swing capture --------------------------------------------------------
#
# Stills of named OBS panels of ProTee's post-shot presentation. CaddieJ never
# opens the swing cameras, never crops OBS, and never reads ProTee's
# recordings. See docs/swing-capture.md and docs/coach-v1.md.
#
# SWING_CAPTURE_PANELS is the list that is captured. A panel left out of that
# list is not Coach evidence, even if some other setting names the same OBS
# source for the floor. `delivery` is optional. Floor replay uses
# OBS_SHOT_VIDEO_SOURCE and is not a swing-capture panel.
# Swing Behind is the down-the-line replay and Swing Side is the face-on
# replay. Do not invent a second copy of a source that exists.
#
# SWING_CAPTURE_PANEL_SWING_SOURCE is a deprecated alias for the behind view.
# It applies only when SWING_CAPTURE_PANEL_SWING_BEHIND_SOURCE is empty. If
# both are set, the explicit behind source wins and the alias is not captured
# again. One OBS source is never captured twice.
# SWING_CAPTURE_SELECTED_FRAMES is the total stills kept for one shot, across
# every panel, not a count per source.
#
# Off by default: it depends on OBS sources CaddieJ does not create, and it
# writes pictures of whoever is on the mat to disk.
SWING_CAPTURE_ENABLED=false
SWING_CAPTURE_PANELS=swing_behind,swing_side,impact,delivery
# Private OBS scene holding every coach source (and All Values), eye on. Nest it
# in the floor scene, eye on, with an opacity 0 Color Correction filter, so OBS
# keeps refreshing the sources and draws nothing on the floor. Never Program.
# CaddieJ never shows or hides a source. See docs/swing-capture.md. Keep the
# floor scene's hidden Impact item if FLOOR_TOP_IMPACT_ENABLED reveals it.
SWING_CAPTURE_SCENE=CaddieJ Capture
SWING_CAPTURE_PANEL_SWING_SOURCE=
SWING_CAPTURE_PANEL_SWING_KIND=dynamic
SWING_CAPTURE_PANEL_SWING_SUPPORTS=body_through_impact,body_in_backswing,whole_body,finish_position,sequence
SWING_CAPTURE_PANEL_SWING_BEHIND_SOURCE=
SWING_CAPTURE_PANEL_SWING_BEHIND_KIND=dynamic
SWING_CAPTURE_PANEL_SWING_BEHIND_SUPPORTS=body_through_impact,body_in_backswing,whole_body,finish_position,sequence
SWING_CAPTURE_PANEL_SWING_SIDE_SOURCE=
SWING_CAPTURE_PANEL_SWING_SIDE_KIND=dynamic
SWING_CAPTURE_PANEL_SWING_SIDE_SUPPORTS=body_through_impact,body_in_backswing,whole_body,finish_position,sequence
SWING_CAPTURE_PANEL_IMPACT_SOURCE=
SWING_CAPTURE_PANEL_IMPACT_KIND=static
SWING_CAPTURE_PANEL_IMPACT_SUPPORTS=
SWING_CAPTURE_PANEL_DELIVERY_SOURCE=
SWING_CAPTURE_PANEL_DELIVERY_KIND=static
SWING_CAPTURE_PANEL_DELIVERY_SUPPORTS=

# Dynamic burst. Long enough to reach the release in both replays; ending at
# 5.0 s with the static pass, it adds nothing to the capture's wall time.
SWING_CAPTURE_DYNAMIC_DELAY_SECONDS=0.5
SWING_CAPTURE_DYNAMIC_DURATION_SECONDS=4.5
SWING_CAPTURE_FPS=10
# Faster from the top to the release, in seconds from the strike like the
# burst. Each still is due at a fixed time from the burst's start, so the
# requested rate is the achieved one on average; each still can still be up to
# one Windows timer tick (15.6 ms) late, and a slow OBS skips stills rather
# than queueing them. `swing_capture_cadence` logs what each shot achieved.
# 0 turns the faster stretch off.
SWING_CAPTURE_DOWNSWING_FPS=20
SWING_CAPTURE_DOWNSWING_DELAY_SECONDS=3.3
SWING_CAPTURE_DOWNSWING_DURATION_SECONDS=1.1
# The impact panel, eight aimed moments down the line and seven face-on. A
# calibrated camera never takes more stills than it has aimed moments.
SWING_CAPTURE_SELECTED_FRAMES=16
# Static pass, after the replay has finished drawing.
SWING_CAPTURE_STATIC_DELAY_SECONDS=3.5
SWING_CAPTURE_STATIC_DURATION_SECONDS=1.5
SWING_CAPTURE_STATIC_FPS=2.0

# One swing on disk, replaced whole on the next shot.
SWING_CAPTURE_OUTPUT_DIR=media/latest_swing
# How many previous captures to keep under media/swing_debug. 0 is production:
# latest only. Raise only while tuning timing.
SWING_CAPTURE_DEBUG_KEEP_SHOTS=0
# How many shot directories to keep under media/swing_shots. 3 is production.
# 20 is about 57 MB of selected frames, or about 261 MB if each shot also has
# a full diagnostic timeline. The cap is 40.
SWING_CAPTURE_EVIDENCE_KEEP=3
# Timing diagnostic. Also write every swing_behind and swing_side screenshot
# already taken, under each shot's diagnostic/ directory, for the next N
# published shots of this run (0–40), and keep those full timelines. A value
# above SWING_CAPTURE_EVIDENCE_KEEP retains that many shot directories.
# 0 is production. With COACHING_VISION_CALLS=true the same timeline is still
# written for every coached shot, then frames the evidence package did not
# select are removed. The pose model is not downloaded during a shot. Install
# it once with scripts/install-pose-model.py. It is written to
# models/pose_landmarker_full.task, or to CADDIEJ_POSE_MODEL when that is set.
# SHA-256 5134a3aad27a58b93da0088d431f366da362b44e3ccfbe3462b3827a839011b1.
SWING_CAPTURE_DIAGNOSTIC_TIMELINE_SHOTS=0
# Shot reports for debugging a real session. Written after the coaching line.
# They do not change frame selection or the cue, and they are not sent anywhere.
#
# Four different things are stored:
# - Diagnostic metadata: report.json and report.md (status, stages, decision, timing).
# - Raw GPT request and response: gpt_request.json and gpt_response.json, only
#   when DIAGNOSTICS_RETAIN_PAYLOADS is true. API keys are redacted. Image bytes
#   are not copied into the JSON. DIAGNOSTICS_PAYLOAD_MAX_BYTES is the size cap.
# - Selected evidence images: the exact frames chosen for the shot, copied into
#   the diagnostic shot folder so capture cleanup can delete its own copies.
#   DIAGNOSTICS_KEEP_SHOTS is how many of those shot folders to keep.
# - Automatic ZIP: media/diagnostics/latest_shot.zip, replaced after each
#   finished shot when DIAGNOSTICS_AUTO_EXPORT_LATEST is true. It holds only
#   that shot. DIAGNOSTICS_INCLUDE_IMAGES puts the copied frames in the zip.
# DIAGNOSTICS_KEEP_SESSIONS is how many session folders remain. 1 keeps the
# session in progress. Older sessions are removed, including their shot copies.
DIAGNOSTICS_ENABLED=true
DIAGNOSTICS_DIR=media/diagnostics
DIAGNOSTICS_KEEP_SESSIONS=1
DIAGNOSTICS_KEEP_SHOTS=3
DIAGNOSTICS_RETAIN_PAYLOADS=true
DIAGNOSTICS_PAYLOAD_MAX_BYTES=1500000
DIAGNOSTICS_AUTO_EXPORT_LATEST=true
DIAGNOSTICS_INCLUDE_IMAGES=true
# Scale each still to this width, keeping the aspect ratio. 0 asks OBS for the
# source's own resolution; anything else must be at least 8 and at most 4096.
SWING_CAPTURE_IMAGE_WIDTH=0
# One still of ProTee's All Values grid per strike, for the coach to read the
# numbers from. Not counted against SWING_CAPTURE_SELECTED_FRAMES.
COACH_METRICS_CAPTURE_ENABLED=false
COACH_METRICS_SOURCE=All Values
# Seconds after the strike, 0-15. One retry if unusable or not yet redrawn.
COACH_METRICS_CAPTURE_DELAY_SECONDS=3.0
