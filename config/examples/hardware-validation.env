# First real ProTee VX + GSPro session.
#
# Copy this file to `.env` in the directory you start CaddieJ from:
#
#   copy config\examples\hardware-validation.env .env
#
# Then confirm it with `caddiej --check-config` before starting.
# See docs/hardware-validation.md.
#
# No secrets. No player name. Floor numbers below are the repository
# defaults (metres), not a measured bay — change them to the real room
# before trusting path angles on a non-square floor.

# --- the shot path --------------------------------------------------------

GSPRO_MODE=interpose
GSPRO_BIND_HOST=127.0.0.1
GSPRO_BIND_PORT=9210
GSPRO_UPSTREAM_HOST=127.0.0.1
GSPRO_UPSTREAM_PORT=921

# GSPRO_IDLE_TIMEOUT is intentionally omitted. The repository default is
# 180 s. Do not lower it until the ProTee VX heartbeat / idle behaviour has
# been measured on real hardware. A short unmeasured value can hang up a
# live monitor during a normal pause. 0 disables the check.

# --- history --------------------------------------------------------------

HISTORY_ENABLED=true
HISTORY_DATABASE_PATH=caddiej.sqlite3
HISTORY_RECORD_RAW_PAYLOADS=true
HISTORY_RAW_PAYLOAD_MAX_BYTES=8192

# --- floor overlay (loopback) ---------------------------------------------

HUD_HOST=127.0.0.1
HUD_PORT=8730
FLOOR_DEMO=false

# All of these are metres on the physical floor, not 0–1 fractions and
# not pixels. Origin is the far-left corner of the back of the bay;
# y is towards the player. The defaults match a 1 m × 1 m identity
# (visually the same as a fresh checkout). Set the real bay when a 10°
# path should be 10° on the hitting strip.
FLOOR_WIDTH_M=1.0
FLOOR_DEPTH_M=1.0
FLOOR_TEE_X_M=0.5
FLOOR_TEE_Y_M=0.72
FLOOR_CLUB_PATH_LENGTH=1.2

# --- everything else off --------------------------------------------------

VIDEO_ENABLED=false
COACHING_PROVIDER=none
SPEECH_ENABLED=false
LIGHTING_ENABLED=false
EFFECTS_ENABLED=false
ASSISTANT_API_ENABLED=false

# Do not create or mutate OBS sources. An already-created Browser Source
# pointed at http://127.0.0.1:8730/ is enough; CaddieJ does not need to
# talk to OBS for this session.
OBS_PROVISION_FLOOR_SOURCE=false
