# Passive observation on the hitting-bay PC.
# ProTee talks to GSPro directly. CaddieJ only reads files.
# Stopping CaddieJ must not affect either.

GSPRO_MODE=observe
GSPRO_ROUND_OBSERVER_ENABLED=true
GSPRO_ROUND_FILE_PATH=
GSPRO_ROUND_POLL_INTERVAL=0.1
PROTEE_OBSERVER_ENABLED=true
PROTEE_ROOT_PATH=
PROTEE_LOG_POLL_INTERVAL=0.1

HUD_HOST=127.0.0.1
HUD_PORT=8730

# Default (non-driver) marker, metres on the physical floor.
FLOOR_TEE_X_M=0.5
FLOOR_TEE_Y_M=0.72
# DRIVER marker. Set these to the hitting-bay driver tee; defaults match above.
FLOOR_TEE_DRIVER_X_M=0.5
FLOOR_TEE_DRIVER_Y_M=0.72
# Hitting strip. X/Y are the physical CENTRE of the rectangle in metres; either
# one left out inherits the default tee. Calibrate width/depth on the bay;
# these are generic defaults, not a measured room.
FLOOR_HITTING_STRIP_X_M=0.5
FLOOR_HITTING_STRIP_Y_M=0.72
FLOOR_HITTING_STRIP_WIDTH_M=0.30
FLOOR_HITTING_STRIP_DEPTH_M=0.45
# Light the turf rather than outline it. Set true in a dark bay.
FLOOR_HITTING_STRIP_FILL=false
# Round result: readable for at least MIN, and off by MAX if the next address
# cycle never arrives. GSPro's result is already 3-6 s behind the strike.
FLOOR_SHOT_RESULT_MIN_DURATION=8
FLOOR_SHOT_RESULT_MAX_DURATION=30

# Optional: create/reconcile the Browser Source if the CaddieJ Test scene exists.
# Manual Browser Source setup is enough. Do not change the projector mapping.
OBS_PROVISION_FLOOR_SOURCE=false
OBS_FLOOR_SCENE=CaddieJ Test
OBS_FLOOR_SOURCE=CaddieJ Floor
OBS_FLOOR_WIDTH=1920
OBS_FLOOR_HEIGHT=1080

# Opt-in: toggle the existing OBS Window Capture of ProTee Shot Video.
# Manual OBS layout is authoritative. CaddieJ only shows/hides the source.
# Required source order in CaddieJ Test (top to bottom): Shot Video, CaddieJ Floor.
FLOOR_SHOT_VIDEO_ENABLED=false
OBS_SHOT_VIDEO_SOURCE=Shot Video
FLOOR_SHOT_VIDEO_DELAY_SECONDS=0.75
FLOOR_SHOT_VIDEO_DURATION_SECONDS=4
