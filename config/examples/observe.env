# Passive observation on the hitting-bay PC.
# ProTee talks to GSPro directly. CaddieJ only reads files.
# Stopping CaddieJ must not affect either.

GSPRO_MODE=observe
GSPRO_ROUND_OBSERVER_ENABLED=true
GSPRO_ROUND_FILE_PATH=
GSPRO_ROUND_POLL_INTERVAL=0.1
PROTEE_OBSERVER_ENABLED=true
PROTEE_ROOT_PATH=
PROTEE_LOG_POLL_INTERVAL=0.1

HUD_HOST=127.0.0.1
HUD_PORT=8730

# Default (non-driver) marker, metres on the physical floor.
FLOOR_TEE_X_M=0.5
FLOOR_TEE_Y_M=0.72
# DRIVER marker. Set these to the hitting-bay driver tee; defaults match above.
FLOOR_TEE_DRIVER_X_M=0.5
FLOOR_TEE_DRIVER_Y_M=0.72
# Round result stays until READY / a new ball, or this many seconds.
FLOOR_SHOT_RESULT_MAX_DURATION=15

# Optional: create/reconcile the Browser Source if the CaddieJ Test scene exists.
# Manual Browser Source setup is enough. Do not change the projector mapping.
OBS_PROVISION_FLOOR_SOURCE=false
OBS_FLOOR_SCENE=CaddieJ Test
OBS_FLOOR_SOURCE=CaddieJ Floor
OBS_FLOOR_WIDTH=1920
OBS_FLOOR_HEIGHT=1080
